# Copy to .env.local and fill in. Never commit .env.local.
# The dashboard talks to the same Supabase project as the storefront.

# ---------------------------------------------------------------------------
# Supabase
# The dashboard reads and writes as the signed-in admin, so RLS enforces
# access — the secret key does not belong here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---------------------------------------------------------------------------
# Storefront — used for "View on site" links and on-demand revalidation.
# REVALIDATE_SECRET must match the storefront's value exactly.
# ---------------------------------------------------------------------------
STOREFRONT_URL=http://localhost:3000
REVALIDATE_SECRET=
