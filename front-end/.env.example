# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase — Dashboard → Project Settings → API Keys
# Without these the storefront falls back to the bundled seed catalogue.
# Legacy JWT names (NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY)
# still work as a fallback if your project predates the sb_ key format.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx       # server-only, bypasses RLS — required for checkout

# ---------------------------------------------------------------------------
# Stripe — Dashboard → Developers → API keys (start in Test mode).
# Webhook secret comes from `stripe listen` locally, or the Dashboard in prod.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ---------------------------------------------------------------------------
# Resend — order confirmation emails (optional; skipped when unset)
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=orders@ordi.com

# ---------------------------------------------------------------------------
# On-demand revalidation — must match the admin dashboard's value.
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Social (Phase 4)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LINE_OA_ID=@ordi
NEXT_PUBLIC_INSTAGRAM_HANDLE=ordi.atelier
NEXT_PUBLIC_SHOPEE_SHOP=ordi
NEXT_PUBLIC_TIKTOK_HANDLE=ordi

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
